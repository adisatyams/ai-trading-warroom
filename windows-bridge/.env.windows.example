# Copy to .env.windows and fill in. Never commit .env.windows (it is git-ignored).

# Deployed Worker URL, no trailing slash
WARROOM_API_URL=https://ai-trading-warroom-api.adi-satya-ms.workers.dev

# Same value as the Worker secret WARROOM_API_KEY
WARROOM_API_KEY=ai_trading_warroom_v7QsSDBf5hhK03bEaKBWi7MMynpBHzIJcNKmqnUDoO0

# Separate credential for the demo-only order polling and acknowledgement API.
EXECUTOR_API_KEY=b12a1c0d4f3e5f6a7b8c9d0e1f2a3b4c

# Must be explicitly set true here AND in the deployed Worker to permit demo orders.
MT5_TRADING_ENABLED=true

EXECUTOR_POLL_SECONDS=5
MT5_ORDER_DEVIATION=20

# Instruments the bridge scans, comma-separated base names. Broker suffixes (EURUSD ->
# EURUSDm) are matched automatically. Keep this list short (10-40 liquid symbols).
# Leave empty only if you really want every Market Watch symbol.
SYMBOLS=XAUUSDm,EURUSDm,GBPUSDm,USDJPYm

# Path to the Exness MT5 terminal (leave empty to auto-detect)
MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

POLL_SECONDS=5
HEARTBEAT_SECONDS=60
MARKET_BATCH_SECONDS=60

# Install/attach WarRoomCalendarEA.mq5 in the demo terminal. It writes high-impact
# events into MT5's Common\Files folder. Set this to that exact file path.
MT5_CALENDAR_FILE=%APPDATA%\MetaQuotes\Terminal\Common\Files\warroom_calendar.json
RISK_SNAPSHOT_SECONDS=60
